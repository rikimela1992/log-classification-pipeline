#!/bin/sh
set -e

if ! getent group log-classify >/dev/null; then
    addgroup --system log-classify
fi
if ! getent passwd log-classify >/dev/null; then
    adduser --system --ingroup log-classify \
        --home /var/lib/log-classification-pipeline \
        --no-create-home --disabled-login --disabled-password log-classify
fi
chown log-classify:log-classify /var/lib/log-classification-pipeline
chmod 700 /var/lib/log-classification-pipeline
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    # Only an upgrade names a previous version; try-restart never starts or enables.
    if [ "${1:-}" = "configure" ] && [ -n "${2:-}" ]; then
        systemctl try-restart log-classification-pipeline.service >/dev/null 2>&1 || true
    fi
fi

exit 0
